# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your values.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
# The .env file is git-ignored — your real keys never get committed.
# ------------------------------------------------------------------

# ==================================================================
# THE BRAIN (LLM)  —  pick ONE provider
#   ollama    -> a model running locally on your PC. FREE, no key, offline.
#   anthropic -> Claude directly from Anthropic. Needs a paid API key.
#   gateway   -> an OpenAI-compatible AI gateway (Bifrost/LiteLLM/etc.),
#                one key routes to many providers.
# ==================================================================
LLM_PROVIDER=ollama

# --- LLM_PROVIDER=ollama (local, free) ---
# Install Ollama (https://ollama.com), then: ollama pull llama3.2:3b
#   llama3.2:3b (fast)  ·  qwen2.5:7b (smarter)  ·  llama3.1:8b (smart, slower)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434

# --- LLM_PROVIDER=anthropic (cloud) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- LLM_PROVIDER=gateway (OpenAI-compatible AI gateway) ---
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_CHAT_MODEL=openai/gpt-4o-mini

# ==================================================================
# THE VOICE (speech-to-text + text-to-speech)  —  pick ONE provider
#   elevenlabs -> ElevenLabs directly (needs an ElevenLabs key)
#   gateway    -> route voice through the AI gateway above
# ==================================================================
VOICE_PROVIDER=elevenlabs

# --- VOICE_PROVIDER=elevenlabs ---
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice the assistant speaks in (find/clone at elevenlabs.io/app/voice-library).
# Default = "Rachel", a stock voice on every account.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1

# --- VOICE_PROVIDER=gateway (uses GATEWAY_BASE_URL / GATEWAY_API_KEY above) ---
GATEWAY_TTS_MODEL=elevenlabs/eleven_flash_v2_5
GATEWAY_TTS_VOICE=EXAVITQu4vr4xnSDxMaL
GATEWAY_STT_MODEL=openai/whisper-1

# ==================================================================
# SPOTIFY (optional) — lets Echo play songs in your Spotify app
# ==================================================================
# 1. Create an app at https://developer.spotify.com/dashboard
#    Redirect URI:  http://127.0.0.1:8000/api/spotify/callback  (Web API)
# 2. Paste its Client ID below and restart the backend.
# 3. Open http://127.0.0.1:8000/api/spotify/login once and approve.
# Note: starting playback requires Spotify Premium (Spotify's API rule).
SPOTIFY_CLIENT_ID=

# ==================================================================
# ASSISTANT
# ==================================================================
ASSISTANT_NAME=Echo
REPLY_MAX_TOKENS=400

# ==================================================================
# LONG-TERM MEMORY (RecallrAI) - optional
# ==================================================================
# Create an API key and project ID in https://app.recallrai.com.
# When enabled, each conversation is mirrored to RecallrAI, the agent fetches
# LOW_LATENCY context before answering, and memories are processed after
# inactivity or when you purge/reset a conversation.
RECALLRAI_ENABLED=false
RECALLRAI_API_KEY=
RECALLRAI_PROJECT_ID=
RECALLRAI_USER_ID=voice-assistant-user
RECALLRAI_RECALL_STRATEGY=low_latency
RECALLRAI_AUTO_PROCESS_AFTER_SECONDS=600
RECALLRAI_LAST_N_MESSAGES=1
RECALLRAI_INCLUDE_SYSTEM_PROMPT=false

# Low-latency routing:
# - Use RECALLRAI_BASE_URL when your forward proxy exposes the RecallrAI API.
# - Use RECALLRAI_FORWARD_PROXY_URL for a classic HTTP(S) forward proxy.
RECALLRAI_BASE_URL=https://api.recallrai.com
RECALLRAI_FORWARD_PROXY_URL=
RECALLRAI_TIMEOUT=15

# Safety: allow the assistant to run arbitrary shell commands on your PC.
# Leave "false" unless you understand the risk.
ALLOW_SHELL_COMMANDS=false
