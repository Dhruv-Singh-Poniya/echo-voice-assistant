# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your values.
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)
# The .env file is git-ignored — your real keys never get committed.
# ------------------------------------------------------------------

# ==================================================================
# THE BRAIN (LLM)  —  pick ONE provider
#   ollama    -> a model running locally on your PC. FREE, no key, offline.
#   anthropic -> Claude directly from Anthropic. Needs a paid API key.
#   gateway   -> an OpenAI-compatible AI gateway (Bifrost/LiteLLM/etc.),
#                one key routes to many providers.
# ==================================================================
LLM_PROVIDER=ollama

# --- LLM_PROVIDER=ollama (local, free) ---
# Install Ollama (https://ollama.com), then: ollama pull llama3.2:3b
#   llama3.2:3b (fast)  ·  qwen2.5:7b (smarter)  ·  llama3.1:8b (smart, slower)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://127.0.0.1:11434

# --- LLM_PROVIDER=anthropic (cloud) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- LLM_PROVIDER=gateway (OpenAI-compatible AI gateway) ---
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_CHAT_MODEL=openai/gpt-4o-mini

# ==================================================================
# THE VOICE (speech-to-text + text-to-speech)  —  pick ONE provider
#   elevenlabs -> ElevenLabs directly (needs an ElevenLabs key)
#   gateway    -> route voice through the AI gateway above
# ==================================================================
VOICE_PROVIDER=elevenlabs

# --- VOICE_PROVIDER=elevenlabs ---
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice the assistant speaks in (find/clone at elevenlabs.io/app/voice-library).
# Default = "Rachel", a stock voice on every account.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v1

# --- VOICE_PROVIDER=gateway (uses GATEWAY_BASE_URL / GATEWAY_API_KEY above) ---
GATEWAY_TTS_MODEL=elevenlabs/eleven_flash_v2_5
GATEWAY_TTS_VOICE=EXAVITQu4vr4xnSDxMaL
GATEWAY_STT_MODEL=openai/whisper-1

# ==================================================================
# ASSISTANT
# ==================================================================
ASSISTANT_NAME=Echo
REPLY_MAX_TOKENS=400

# Safety: allow the assistant to run arbitrary shell commands on your PC.
# Leave "false" unless you understand the risk.
ALLOW_SHELL_COMMANDS=false
